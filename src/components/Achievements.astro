---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import { achievements, education } from "../data/achievements";

const iconFor = (kind: string) => (kind === "award" ? "award" : "heart");
---

<section id="achievements" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading
      index="06"
      eyebrow="Beyond the code"
      title="Recognition, education & community"
    />

    <div class="mt-14 grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <!-- Achievements -->
      <div class="space-y-4">
        {
          achievements.map((a, i) => (
            <div
              class="panel flex items-start gap-5 p-6 transition-colors hover:border-[var(--color-bronze)]/50"
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-[var(--color-line)] bg-[var(--color-base)] text-[var(--color-gold)]">
                <Icon name={iconFor(a.kind)} class="h-6 w-6" />
              </span>
              <div>
                <div class="flex flex-wrap items-baseline gap-x-3">
                  <h3 class="font-display text-lg font-medium text-[var(--color-fg)]">
                    {a.title}
                  </h3>
                  <span class="font-mono text-xs text-[var(--color-gold)]">{a.year}</span>
                </div>
                <p class="mt-1.5 text-[0.92rem] leading-relaxed text-[var(--color-muted)]">
                  {a.detail}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Education -->
      <div data-reveal style="--reveal-delay:120ms">
        <h3 class="font-mono text-xs uppercase tracking-widest text-[var(--color-faint)]">
          Education
        </h3>
        <div class="mt-4 space-y-4">
          {
            education.map((e) => (
              <div class="panel p-6">
                <span class="grid h-11 w-11 place-items-center rounded-xl border border-[var(--color-line)] bg-[var(--color-base)] text-[var(--color-gold)]">
                  <Icon name="graduation" class="h-5 w-5" />
                </span>
                <h4 class="mt-4 font-display text-lg font-medium text-[var(--color-fg)]">
                  {e.institution}
                </h4>
                <p class="mt-1 font-mono text-sm text-[var(--color-gold)]">{e.credential}</p>
                <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{e.detail}</p>
                <p class="mt-3 font-mono text-[0.7rem] text-[var(--color-faint)]">{e.period}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
