};

const isBrand = ["github", "linkedin", "twitter", "devto", "mail", "npm"].includes(name);
const fillMode = isBrand ? "currentColor" : "none";
---

<svg
  viewBox="0 0 24 24"
  fill={fillMode}
  class={className}
  aria-hidden="true"
  set:html={paths[name] ?? ""}
/>
