---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;

const linkIcon = (kind: string) =>
  kind === "repo" ? "github" : kind === "npm" ? "npm" : "arrowUpRight";
---

<article
  class="group panel flex flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:border-[var(--color-bronze)]"
  data-type={project.type}
>
  <!-- Visual -->
  <div class="relative aspect-[16/10] overflow-hidden border-b border-[var(--color-line)]">
    {
      project.image ? (
        <Image
          src={project.image}
          alt={`${project.name} — ${project.tag}`}
          widths={[400, 600, 900]}
          sizes="(max-width: 640px) 100vw, 420px"
          class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
          loading="lazy"
        />
      ) : (
        <div class="relative grid h-full place-items-center bg-[var(--color-ink)]">
          <div
            class="absolute inset-0 opacity-40"
            style="background-image: linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 28px 28px;"
          />
          <div
            class="absolute -top-8 right-0 h-40 w-40 rounded-full bg-[radial-gradient(circle,rgba(224,168,46,0.22),transparent_65%)] blur-xl"
          />
          <span class="relative font-display text-5xl font-light italic text-gold-grad">
            {project.name}
          </span>
          <span class="absolute bottom-4 left-5 font-mono text-[0.65rem] uppercase tracking-widest text-[var(--color-faint)]">
            {project.tag}
          </span>
        </div>
      )
    }
    <!-- type badge -->
    <span
      class={`absolute right-3 top-3 rounded-full px-2.5 py-1 font-mono text-[0.6rem] uppercase tracking-wider backdrop-blur ${
        project.type === "oss"
          ? "bg-[var(--color-teal)]/15 text-[var(--color-teal)] border border-[var(--color-teal)]/30"
          : "bg-[var(--color-gold)]/15 text-[var(--color-gold)] border border-[var(--color-gold)]/30"
      }`}
    >
      {project.type === "oss" ? "Open Source" : "Shipped"}
    </span>
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-display text-xl font-medium text-[var(--color-fg)]">{project.name}</h3>
      <span class="font-mono text-[0.68rem] text-[var(--color-faint)]">{project.period}</span>
    </div>
    <p class="mt-1 font-mono text-[0.72rem] uppercase tracking-wide text-[var(--color-gold)]">
      {project.tag}
    </p>
    <p class="mt-3 flex-1 text-[0.92rem] leading-relaxed text-[var(--color-muted)]">
      {project.description}
    </p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {
        project.stack.slice(0, 6).map((t) => (
          <span class="rounded-md border border-[var(--color-line)] bg-[var(--color-base)] px-2 py-0.5 font-mono text-[0.66rem] text-[var(--color-faint)]">
            {t}
          </span>
        ))
      }
    </div>

    <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 border-t border-[var(--color-line)] pt-4">
      {
        project.links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group/link inline-flex items-center gap-1.5 font-mono text-xs text-[var(--color-muted)] transition-colors hover:text-[var(--color-gold)]"
          >
            <Icon name={linkIcon(l.kind)} class="h-3.5 w-3.5" />
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
</article>
