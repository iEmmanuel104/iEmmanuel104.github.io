---
import Icon from "./Icon.astro";
import { profile } from "../data/profile";
---

<section id="top" class="relative min-h-screen overflow-hidden pt-28 pb-16 sm:pt-32">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-[1.15fr_0.85fr]">
    <!-- Left: headline -->
    <div>
      <div
        class="inline-flex items-center gap-2.5 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)]/70 px-4 py-1.5"
        data-reveal
      >
        <span class="relative flex h-2 w-2">
          <span class="pulse-ring absolute inline-flex h-2 w-2 rounded-full bg-[var(--color-teal)]"></span>
        </span>
        <span class="font-mono text-xs tracking-wide text-[var(--color-muted)]">
          {profile.availability}
        </span>
      </div>

      <h1
        class="mt-7 font-display text-[clamp(2.9rem,8vw,5.5rem)] font-light leading-[0.95] tracking-tight"
        data-reveal
        style="--reveal-delay:80ms"
      >
        <span class="block text-[var(--color-fg)]">Emmanuel</span>
        <span class="block italic text-gold-grad">Umukoro</span>
      </h1>

      <!-- Animated role line -->
      <div
        class="mt-6 flex items-center gap-3 font-mono text-base text-[var(--color-muted)] sm:text-lg"
        data-reveal
        style="--reveal-delay:160ms"
      >
        <Icon name="terminal" class="h-4 w-4 shrink-0 text-[var(--color-gold)]" />
        <span class="text-[var(--color-faint)]">~/</span>
        <span id="role-rotator" class="text-[var(--color-fg)]">{profile.roles[0]}</span>
        <span class="inline-block h-5 w-2 animate-pulse bg-[var(--color-gold)]"></span>
      </div>

      <p
        class="mt-7 max-w-xl text-[1.05rem] leading-relaxed text-[var(--color-muted)]"
        data-reveal
        style="--reveal-delay:240ms"
      >
        {profile.bio}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay:320ms">
        <a
          href="#projects"
          class="group inline-flex items-center gap-2 rounded-full bg-[var(--color-gold)] px-6 py-3.5 font-mono text-sm font-medium text-[var(--color-ink)] transition-all hover:bg-[var(--color-gold-bright)] hover:shadow-[0_0_30px_-6px_var(--color-gold)]"
        >
          View selected work
          <Icon name="arrowUpRight" class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] px-6 py-3.5 font-mono text-sm text-[var(--color-fg)] transition-all hover:border-[var(--color-bronze)] hover:text-[var(--color-gold)]"
        >
          Get in touch
        </a>
      </div>

      <!-- Socials -->
      <div class="mt-8 flex items-center gap-4" data-reveal style="--reveal-delay:400ms">
        <span class="font-mono text-xs text-[var(--color-faint)]">FIND ME</span>
        <div class="h-px w-8 bg-[var(--color-line)]"></div>
        {
          profile.socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="text-[var(--color-muted)] transition-colors hover:text-[var(--color-gold)]"
            >
              <Icon name={s.icon} class="h-5 w-5" />
            </a>
          ))
        }
      </div>
    </div>

    <!-- Right: terminal / system card motif -->
    <div class="relative" data-reveal style="--reveal-delay:200ms">
      <!-- glow -->
      <div
        class="absolute -inset-6 -z-10 rounded-[2rem] bg-[radial-gradient(circle_at_70%_20%,rgba(224,168,46,0.18),transparent_60%)] blur-2xl"
      >
      </div>

      <div class="panel animate-float overflow-hidden p-0 shadow-2xl shadow-black/40">
        <!-- title bar -->
        <div class="flex items-center gap-2 border-b border-[var(--color-line)] bg-[var(--color-ink)]/60 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
          <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
          <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 font-mono text-xs text-[var(--color-faint)]">~/emmanuel — profile.ts</span>
        </div>

        <!-- code -->
        <pre class="overflow-x-auto p-5 font-mono text-[0.78rem] leading-relaxed sm:text-[0.82rem]"><code><span class="text-[var(--color-faint)]">const</span> <span class="text-[var(--color-teal)]">engineer</span> <span class="text-[var(--color-faint)]">=</span> {'{'}
  role<span class="text-[var(--color-faint)]">:</span> <span class="text-[var(--color-gold)]">"Senior Software Engineer"</span>,
  focus<span class="text-[var(--color-faint)]">:</span> [<span class="text-[var(--color-gold)]">"Web3"</span>, <span class="text-[var(--color-gold)]">"AI/LLM"</span>, <span class="text-[var(--color-gold)]">"Scale"</span>],
  years<span class="text-[var(--color-faint)]">:</span> <span class="text-[var(--color-teal)]">5</span>,
  ships<span class="text-[var(--color-faint)]">:</span> <span class="text-[var(--color-gold)]">"production systems"</span>,
  stack<span class="text-[var(--color-faint)]">:</span> {'{'}
    backend<span class="text-[var(--color-faint)]">:</span> [<span class="text-[var(--color-gold)]">"Node"</span>, <span class="text-[var(--color-gold)]">"NestJS"</span>, <span class="text-[var(--color-gold)]">"Fastify"</span>],
    chain<span class="text-[var(--color-faint)]">:</span> [<span class="text-[var(--color-gold)]">"Solidity"</span>, <span class="text-[var(--color-gold)]">"ZK-SNARKs"</span>],
    ai<span class="text-[var(--color-faint)]">:</span> [<span class="text-[var(--color-gold)]">"MCP"</span>, <span class="text-[var(--color-gold)]">"RAG"</span>, <span class="text-[var(--color-gold)]">"Vercel AI"</span>],
  {'}'},
  status<span class="text-[var(--color-faint)]">:</span> <span class="text-[var(--color-teal)]">"available"</span>,
{'}'}<span class="text-[var(--color-faint)]">;</span></code></pre>
      </div>
    </div>
  </div>

  <!-- Stats strip -->
  <div class="mx-auto mt-16 max-w-6xl px-5 sm:px-8">
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-line)] sm:grid-cols-4" data-reveal>
      {
        profile.stats.map((s) => (
          <div class="bg-[var(--color-surface)] px-5 py-6 text-center sm:text-left">
            <div class="font-display text-3xl font-semibold text-gold-grad sm:text-4xl">{s.value}</div>
            <div class="mt-1 font-mono text-[0.7rem] uppercase leading-snug tracking-wider text-[var(--color-faint)]">
              {s.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline define:vars={{ roles: profile.roles }}>
  (function () {
    const el = document.getElementById("role-rotator");
    if (!el) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let i = 0;
    setInterval(() => {
      i = (i + 1) % roles.length;
      el.style.opacity = "0";
      setTimeout(() => {
        el.textContent = roles[i];
        el.style.opacity = "1";
      }, 220);
    }, 2600);
    el.style.transition = "opacity 0.22s ease";
  })();
</script>
